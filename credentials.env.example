# Copy to credentials.env and populate before running deploy.sh. Never commit credentials.env.
#
# Required when cloning from internal GitLab (disconnected-imageset, disconnected-s3)
GITLAB_TOKEN=

# Required for S3 → Minio mirroring (--s3-mirror-config). AWS source credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_URL=https://s3.amazonaws.com

# Bastion MinIO credentials — must match minio_username / minio_password in ansible/vars/all.yml.
# Defaults match the bastion-rhoai-services role defaults (minioadmin / minioadmin).
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin
